<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Фоновый градиент / размытие -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_gradient_overlay" />

    <!-- Единый прокручиваемый контейнер экрана (Viewport Scroll) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="60dp">

            <!-- ВЕРХНЯЯ ПАНЕЛЬ: Заголовок (слева) и Статус-бар (справа) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="64dp"
                android:clipChildren="false">

                <!-- Главный заголовок секции в левом верхнем углу с отступом -->
                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Apple TV"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <!-- Компактный полупрозрачный статус-бар (часы и настройки) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/status_pill_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextClock
                        android:id="@+id/main_text_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format24Hour="HH:mm"
                        android:format12Hour="h:mm a"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/btn_launcher_settings"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="10dp"
                        android:focusable="true"
                        android:clickable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="⚙"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- Отступ перед Доком -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <!-- ДОК ИЗБРАННЫХ: Отцентрирован, сужен, с большими отступами от краев -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:clipChildren="false">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_dock_bg"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:clipChildren="false">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dock_recycler"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="horizontal" />
                </FrameLayout>
            </LinearLayout>

            <!-- Заголовок сетки приложений -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp"
                android:text="Все приложения"
                android:textColor="#88FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- СЕТКА ВСЕХ ПРИЛОЖЕНИЙ (Вертикальный скролл с отступами) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="64dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
