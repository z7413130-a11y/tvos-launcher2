<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:orientation="horizontal"
    android:paddingTop="60dp"
    android:paddingBottom="60dp"
    android:paddingStart="100dp"
    android:paddingEnd="100dp">

    <!-- Левая панель с иконкой (остается по центру) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        
        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:background="@drawable/bg_settings_left_panel"
            android:elevation="0dp">
            
            <ImageView
                android:id="@+id/dynamic_left_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_panel_appearance" />
        </FrameLayout>
    </LinearLayout>

    <!-- Правая панель со списком (теперь центрируется по вертикали) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical" 
        android:paddingStart="60dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="#999999"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp"/>

        <!-- Высота wrap_content обязательна для правильной центровки всего блока -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
