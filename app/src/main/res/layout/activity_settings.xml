<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:orientation="horizontal"
    android:paddingTop="80dp"
    android:paddingBottom="80dp"
    android:paddingStart="120dp"
    android:paddingEnd="120dp">

    <!-- Левая панель (статичный серый фон + меняющаяся иконка) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        
        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@drawable/bg_settings_left_panel"
            android:elevation="12dp">
            
            <ImageView
                android:id="@+id/dynamic_left_icon"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_panel_appearance" />
        </FrameLayout>
    </LinearLayout>

    <!-- Правая панель (Меню настроек) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:paddingStart="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="#999999"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:layout_marginBottom="40dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
