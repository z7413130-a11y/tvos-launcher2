<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:orientation="horizontal"
    android:paddingTop="60dp"
    android:paddingBottom="60dp"
    android:paddingStart="80dp"
    android:paddingEnd="80dp">

    <!-- Левая панель с иконкой -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@drawable/bg_settings_left_panel"
            android:elevation="8dp">
            
            <ImageView
                android:id="@+id/dynamic_left_icon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_panel_appearance" />
        </FrameLayout>
    </LinearLayout>

    <!-- Правая панель со списком настроек -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:paddingStart="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#999999"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
